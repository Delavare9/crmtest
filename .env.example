# Скопируйте в .env.local и заполните. Для локального стека проще: npm run env:local
#
# Фронтенд (попадает в сборку, публичные значения):
#   адрес проекта Supabase и публичный ключ (Project Settings → API Keys → Publishable key).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Только для scripts/seed.ts и tests/api — на машине администратора или в CI.
# Никогда не добавляйте его в Vercel и не начинайте имя с VITE_.
#   Project Settings → API Keys → Secret key.
SUPABASE_SECRET_KEY=

# Пароль демо-пользователей (выбор владельца), не короче 8 символов.
SEED_PASSWORD=
